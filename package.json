{
  "name": "react-native-sharp",
  "version": "0.1.0",
  "description": "Node sharp-inspired image processing for React Native, powered by Nitro Modules and libvips",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && npm run build",
    "download-libvips": "node scripts/download-libvips.js",
    "postinstall": "node scripts/download-libvips.js --if-missing",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "sharp",
    "libvips",
    "image",
    "nitro",
    "nitro-modules"
  ],
  "files": [
    "src",
    "!src/__tests__",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "scripts",
    "third_party/libvips/VERSION.json",
    "third_party/libvips/README.md",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "LICENSE",
    "README.md"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "repository": "https://github.com/yashp98/react-native-sharp.git",
  "author": "yashp98",
  "license": "MIT",
  "bugs": "https://github.com/yashp98/react-native-sharp/issues",
  "homepage": "https://github.com/yashp98/react-native-sharp#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.36.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.36.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "watchman": false,
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example/"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "verbatimModuleSyntax": false,
            "strict": true,
            "skipLibCheck": true
          }
        }
      ]
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
